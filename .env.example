# Copy to .env and adjust. Placeholders only: never commit a real secret.

# SQLite file by default; for Postgres use e.g.
#   postgresql+psycopg://restock:restock@localhost:5432/restock
DATABASE_URL=sqlite:///./restock.db

# HMAC secret shared with the gateway. The app refuses to start while this is still the
# change-me placeholder: set your own, or the synthetic "assessment-secret" that the supplied
# fixtures and tools/sign_payload.py examples use, to replay them.
WEBHOOK_SECRET=change-me
# Accept X-Webhook-Timestamp values at most this many seconds from server time (either way).
WEBHOOK_REPLAY_WINDOW_SECONDS=300
# The largest webhook body accepted, in bytes; a larger one gets 413 before it is read.
WEBHOOK_MAX_BODY_BYTES=65536
# Refuse an event (422) whose observed_at is more than this many seconds ahead of server time.
OBSERVED_AT_MAX_FUTURE_SECONDS=300

# Where replenishment orders are POSTed ({ERP_URL}/orders). The default is the mock ERP
# mounted inside this app. `make run` sets ERP_URL from its PORT (the environment wins over
# this file); change it here for `.venv/bin/restock run --port ...` on another port.
ERP_URL=http://127.0.0.1:8000/mock-erp
# Mount the mock ERP (and its unauthenticated control endpoint) at /mock-erp. Set it to false
# wherever ERP_URL points at a real ERP.
ERP_MOCK_ENABLED=true
ERP_TIMEOUT_SECONDS=5
ERP_MAX_ATTEMPTS=6
ERP_BACKOFF_BASE_SECONDS=1
ERP_BACKOFF_CAP_SECONDS=30
# A Retry-After from the ERP is honoured up to this many seconds.
ERP_RETRY_AFTER_MAX_SECONDS=300

LOG_LEVEL=INFO
# Run the delivery worker thread inside the web process.
WORKER_ENABLED=true
